# Apple ID notarization credentials. Copy this file to .env; .env is ignored by Git.
NOTARY_APPLE_ID=developer@example.com
NOTARY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTARY_TEAM_ID=ABCDEFGHIJ

# Optional. These defaults are used when omitted.
NOTARY_KEYCHAIN_PROFILE=MacScopeNotary
# DEVELOPER_ID_APPLICATION=Developer ID Application: Your Name (ABCDEFGHIJ)
